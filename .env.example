# ============================================================
# AuraList — Environment Variable Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# MongoDB connection string (required)
# Local example: mongodb://127.0.0.1:27017/auralist
# Atlas example: mongodb+srv://<user>:<password>@cluster.mongodb.net/auralist
MONGODB_URI=mongodb://127.0.0.1:27017/auralist

# JWT signing secret (required — must be at least 32 characters)
# Generate a strong random key: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_long_random_jwt_secret_key_minimum_32_characters_here

# Server port (optional — defaults to 3000)
PORT=3000

# Comma-separated list of allowed CORS origins (optional)
# Defaults to: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN=http://localhost:3000

# Set to 'production' when deploying; omit or set to 'development' locally
NODE_ENV=development

# Reverse proxy trust hops (optional)
# When deploying behind a reverse proxy (e.g., Nginx, Cloudflare, AWS ALB, Heroku),
# set to the number of trusted hops (e.g. 1) or specific trusted subnets/IPs (e.g. 'loopback').
# Omit or leave empty for direct local development.
# TRUST_PROXY=1

# ============================================================
# Music Provider Integrations (Backend-Only)
# ============================================================

# Jamendo API Client ID (optional — required only when Jamendo provider is enabled)
# Obtain a free client ID at: https://developer.jamendo.com/
JAMENDO_CLIENT_ID=your_jamendo_client_id_here

# Audius API Key (optional — provides higher rate limits for Audius decentralized API)
# Register at: https://audius.org/
AUDIUS_API_KEY=

